# Copy to .env ON THE PI ONLY and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# Used by deploy/apply-signalk-config.sh (the VICTRON_* pair) and by the agent.

# What the boat is called in every message, notification and on the page. Not
# a word the crew group uses as a command (status, boat, how, where, ok), or the
# agent will mistake its own replies for questions.
BOAT_NAME=Seabird

# Victron MPPT solar charger, from VictronConnect:
#   device -> gear icon -> Product info -> Instant readout via Bluetooth
# MAC is aa:bb:cc:dd:ee:ff, key is 32 hex characters.
# Signal K read token. Needed whenever Signal K runs with security enabled,
# which the installer does by default. Without it the agent connects and is
# told nothing at all - see the README. Get one with:
#   python -m agent.main --request-access
SIGNALK_TOKEN=

VICTRON_MPPT_MAC=
VICTRON_MPPT_KEY=

# Signal, via signal-cli linked as a secondary device (agent/notify.py).
# Run deploy/install-signal-cli.sh first, then --link to pair with your phone.
# All numbers in international format, +1555... Leave SIGNAL_ACCOUNT empty and
# alerts are logged but not sent.
SIGNAL_ACCOUNT=
# One number, or several separated by commas: +15555550100, +15555550101
# Each phone gets its own copy of every alert, and a number that is wrong or
# unregistered does not stop the others being told.
SIGNAL_RECIPIENT=
# Or send to a group instead (base64 group id from `signal-cli listGroups`).
# Takes precedence over SIGNAL_RECIPIENT, and is cheaper than about three
# separate numbers: one send instead of one per phone.
SIGNAL_GROUP=

# Lowest severity worth sending: normal, alert, warn, alarm, emergency.
AGENT_NOTIFY_MIN_SEVERITY=alert

# Days of daily logs to keep in logs/. Finished days are gzipped whatever
# this is set to; 0 keeps every day forever.
AGENT_LOG_RETENTION_DAYS=90

# The ship's log: one markdown entry a day, newest first, built from the daily
# log rather than from live instruments. Figures throughout, computed on the
# boat: it needs no key, no account and no internet. Written at this hour, UTC.
AGENT_SHIPS_LOG=/home/pi/boat-agent/logs/ships-log.md
AGENT_SHIPS_LOG_HOUR=6
# Entries kept in the file. Matches the log retention by default: the entries
# should not outlive the logs they were computed from.
AGENT_SHIPS_LOG_ENTRIES=90

# Where the crew tells the agent the hook is down. Written by --anchor-down
# and --anchor-up, read by the running agent within a few seconds. It survives
# a reboot on purpose: an anchor watch that forgets itself at 0300 is worse
# than none, because you believe you have one.
AGENT_ANCHOR_FILE=/home/pi/boat-agent/logs/anchor.json

# Alerts on this machine's screen (agent/desktop.py), through notify-send.
# The same threshold as Signal by default, so everything that gets a message
# also gets a notification. The two are independent: raise one without the
# other if you want the screen quieter than the phone, or louder.
AGENT_DESKTOP_NOTIFY=1
AGENT_DESKTOP_MIN_SEVERITY=alert
# AGENT_NOTIFY_SEND=notify-send

# The noise this machine makes itself (agent/sound.py). Every Signal message
# depends on Starlink being up; the speakers do not. On the nav laptop this is
# the alarm that actually wakes the crew, so it is on by default.
AGENT_ALARM_SOUND=1
# Lowest severity worth making a noise about. Deliberately higher than the
# Signal threshold: a machine that beeps at every warning gets its volume
# turned down, and then the drag alarm is silent too.
AGENT_ALARM_MIN_SEVERITY=alarm
# Seconds between soundings while an alert is still standing.
AGENT_ALARM_REPEAT=20
# Force a player instead of letting it find one (pw-play, paplay, aplay,
# ffplay, in that order). {file} is where the .wav path goes.
# AGENT_ALARM_PLAYER=aplay -q {file}
# Where the generated alarm sound lives, and where --hush records a quiet
# period. A hush always has an expiry: the alarm somebody switched off and
# forgot is the one that was going to save them.
# AGENT_ALARM_WAV=/home/pi/boat-agent/logs/alarm.wav
# AGENT_HUSH_FILE=/home/pi/boat-agent/logs/hush.json

# Where --silence records that EVERY channel is off: the speaker, Signal and
# this machine's screen together. Unlike a hush it does not expire, because it
# is granted for a situation - hauled out, alongside, laid up - rather than in
# the middle of an event. The price of that is that the agent nags about it, in
# the journal twice an hour, on the console, on the page, in the crew group's
# status reply and in the ship's log, until somebody runs `boat --unsilence`.
# There is no env var to turn the alarms off: that would be an off switch
# nobody could see. Use the command.
# AGENT_SILENCE_FILE=/home/pi/boat-agent/logs/silence.json

# The forecast (agent/weather.py), from Open-Meteo. No key and no account, so
# it is on by default. It needs a link and the boat's own position and says
# nothing without either; a rule then warns when a blow is coming. Set this to
# 0 to stop the agent reaching out at all.
AGENT_WEATHER=1
# Seconds between fetches. The models behind it update no faster than hourly,
# and it refetches early anyway if the boat moves more than about 8 miles.
AGENT_WEATHER_INTERVAL=3600
# How far ahead the forecast rule looks before it decides a blow is coming.
# Long enough to get the anchor up and be somewhere else; short enough that
# the model is still worth believing.
AGENT_WEATHER_OUTLOOK_HOURS=12
# And how far ahead it looks once the hook is down, which is a different
# question: not the next twelve hours but tonight. Also the window checked and
# reported the moment --anchor-down arms the watch. A boat anchoring at 1500
# wants to know about 0300, and twelve hours does not reach it.
AGENT_ANCHOR_OUTLOOK_HOURS=18

# A page for the phone in your pocket (agent/ui.py), served by the agent on the
# boat's own network. Arming the anchor watch, seeing what the night is
# forecast to do, and hushing the speaker are each one tap.
#
# Off by default, and on localhost when it is on. The controls arm and clear an
# anchor watch, so before binding it to the boat's WiFi set a token: the page
# then needs ?t=<token> in its URL and refuses everything without it. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(12))"
AGENT_UI=0
# AGENT_UI_BIND=0.0.0.0
AGENT_UI_PORT=8375
# AGENT_UI_TOKEN=

# The zone times are SHOWN in. Everything written down stays UTC whatever this
# says: the daily log, the anchor file and every timestamp a rule reasons about.
# A boat crosses zones and lays up in another country, and a log in local time
# cannot be compared with itself six months later. But nobody stands a watch in
# UTC either, so the screen converts on the way out and always names the zone.
#
# Empty means the machine's own zone, which on the nav laptop is boat time. Set
# an IANA name when the laptop's zone is wrong, which after a delivery it is.
# AGENT_TIMEZONE=Europe/Helsinki

# Answer questions asked in the crew group: status, weather, anchor, hush,
# sound, help. Reading only. It will not arm or weigh an anchor by text,
# because that would arm a watch at a position nobody has checked, or disable
# an alarm from a bar.
#
# Polling rather than a daemon: signal-cli takes about four seconds to start a
# JVM, so an answer arrives within a minute instead of at once. Nothing here is
# an alarm and the alarms do not come this way. Receiving on a timer also keeps
# the Signal session healthy, which the sending side quietly depends on.
SIGNAL_LISTEN=1
SIGNAL_POLL=60
